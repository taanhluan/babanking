generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  MEMBER
  CONTRIBUTOR
  REVIEWER
  ADMIN
}

enum ContentType {
  BANKING_JOURNEY
  BA_PRACTICE
  CASE_STUDY
  CAREER_LEVEL
  BA_DOCUMENT
  CUSTOMER_SEGMENT
  GLOSSARY_ENTRY
}

enum RevisionStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum AccountStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AccessRequestStatus {
  NEW
  CONTACTED
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  APPROVED
  REJECTED
  CONVERTED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum BillingPeriod {
  MONTHLY
  QUARTERLY
  ANNUAL
  CUSTOM
}

enum AccessSource {
  PAID
  INTERNAL
  COMPLIMENTARY
}

enum RenewalStatus {
  REQUESTED
  CONTACTED
  PAYMENT_PENDING
  COMPLETED
  REJECTED
}

enum TranslationStatus {
  NOT_STARTED
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  PUBLISHED
  OUTDATED
}

enum KnowledgePermission {
  VIEW
  CREATE
  EDIT
  REVIEW
  PUBLISH
  MANAGE
}

enum GrantEffect {
  ALLOW
  DENY
}

enum GrantStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum PackageAssignmentStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum KnowledgeScopeType {
  BANKING_DOMAIN
  BA_PRACTICE
  CAREER
  CUSTOM
}

enum ContentAccessMode {
  ANY_SCOPE
  ALL_SCOPES
  CONTENT_GRANT_ONLY
}

enum ContentScopeRelationship {
  PRIMARY
  SECONDARY
  SUPPORTING
}

model User {
  id                   String                           @id @default(cuid())
  name                 String
  email                String                           @unique
  passwordHash         String
  role                 Role                             @default(MEMBER)
  isActive             Boolean                          @default(true)
  accountStatus        AccountStatus                    @default(ACTIVE)
  preferredLocale      String                           @default("en")
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt
  lastLoginAt          DateTime?
  ownedContent         ContentItem[]                    @relation("ContentOwner")
  revisions            ContentRevision[]                @relation("RevisionAuthor")
  reviews              ContentRevision[]                @relation("RevisionReviewer")
  bookmarks            Bookmark[]
  activities           ReadingActivity[]
  careerPreference     UserCareerPreference?
  auditLogs            AuditLog[]
  memberships          Membership[]                     @relation("MemberMemberships")
  createdMemberships   Membership[]                     @relation("MembershipCreator")
  payments             PaymentRecord[]                  @relation("MemberPayments")
  verifiedPayments     PaymentRecord[]                  @relation("PaymentVerifier")
  activationTokens     AccountActivationToken[]
  convertedRequests    AccessRequest[]                  @relation("ConvertedUser")
  renewalRequests      RenewalRequest[]
  authoredTranslations ContentTranslation[]             @relation("TranslationOwner")
  translationRevisions TranslationRevision[]            @relation("TranslationAuthor")
  translationReviews   TranslationRevision[]            @relation("TranslationReviewer")
  scopeGrants          UserScopeGrant[]                 @relation("ScopeGrantUser")
  scopeGrantsGiven     UserScopeGrant[]                 @relation("ScopeGrantCreator")
  scopeGrantsRevoked   UserScopeGrant[]                 @relation("ScopeGrantRevoker")
  contentGrants        UserContentGrant[]               @relation("ContentGrantUser")
  contentGrantsGiven   UserContentGrant[]               @relation("ContentGrantCreator")
  contentGrantsRevoked UserContentGrant[]               @relation("ContentGrantRevoker")
  packageAssignments   UserKnowledgePackageAssignment[] @relation("PackageAssignmentUser")
  packagesAssigned     UserKnowledgePackageAssignment[] @relation("PackageAssignmentCreator")
  packagesRevoked      UserKnowledgePackageAssignment[] @relation("PackageAssignmentRevoker")
  isBaTeamMember       Boolean                          @default(false)
  baPlans              BaPerformancePlan[]              @relation("BaPlanOwner")
  baPlansApproved      BaPerformancePlan[]              @relation("BaPlanApprover")
  baPlansAnnualReviews BaPerformancePlan[]              @relation("BaPlanAnnualReviewer")
  baQuartersApproved   BaPlanQuarter[]                  @relation("BaQuarterKpiApprover")
  baQuartersReviewed   BaPlanQuarter[]                  @relation("BaQuarterReviewer")
  baKpiProgressLogs    BaKpiProgressLog[]               @relation("BaKpiProgressAuthor")
  baKpiAdjustments     BaKpiAdjustment[]                @relation("BaKpiAdjustmentActor")
  baTeamProfile        BaTeamProfile?
  baAllocations        BaAllocation[]                   @relation("BaAllocationOwner")
  baAllocationsCreated BaAllocation[]                   @relation("BaAllocationCreator")
  baAllocationsUpdated BaAllocation[]                   @relation("BaAllocationUpdater")

  @@index([email])
  @@index([role, isActive])
}

model MembershipPlan {
  id              String                      @id @default(cuid())
  name            String
  code            String                      @unique
  description     String
  price           Int
  currency        String
  billingPeriod   BillingPeriod
  durationDays    Int
  featuresJson    String                      @default("[]")
  displayOrder    Int                         @default(0)
  isActive        Boolean                     @default(true)
  isPublic        Boolean                     @default(false)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  requests        AccessRequest[]
  memberships     Membership[]
  payments        PaymentRecord[]
  renewalRequests RenewalRequest[]
  translations    MembershipPlanTranslation[]

  @@index([isActive, isPublic, displayOrder])
}

model MembershipPlanTranslation {
  id           String         @id @default(cuid())
  planId       String
  locale       String
  name         String
  description  String
  featuresJson String         @default("[]")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  plan         MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, locale])
  @@index([locale])
}

model AccessRequest {
  id                    String              @id @default(cuid())
  name                  String
  email                 String
  organization          String?
  jobTitle              String
  currentBALevel        String?
  primaryInterest       String
  professionalObjective String
  requestedPlanId       String?
  status                AccessRequestStatus @default(NEW)
  consentAccepted       Boolean
  preferredLocale       String              @default("en")
  adminNote             String?
  rejectionReason       String?
  contactedAt           DateTime?
  convertedUserId       String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  requestedPlan         MembershipPlan?     @relation(fields: [requestedPlanId], references: [id])
  convertedUser         User?               @relation("ConvertedUser", fields: [convertedUserId], references: [id])
  payments              PaymentRecord[]

  @@index([email, createdAt])
  @@index([status, createdAt])
}

model Membership {
  id           String           @id @default(cuid())
  userId       String
  planId       String?
  status       MembershipStatus @default(PENDING)
  accessSource AccessSource
  startsAt     DateTime
  expiresAt    DateTime
  suspendedAt  DateTime?
  cancelledAt  DateTime?
  createdById  String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  user         User             @relation("MemberMemberships", fields: [userId], references: [id])
  plan         MembershipPlan?  @relation(fields: [planId], references: [id])
  createdBy    User             @relation("MembershipCreator", fields: [createdById], references: [id])
  payments     PaymentRecord[]

  @@index([userId, status, startsAt, expiresAt])
  @@index([planId, status])
}

model PaymentRecord {
  id                String          @id @default(cuid())
  userId            String?
  membershipId      String?
  accessRequestId   String?
  planId            String?
  amount            Int
  currency          String
  method            String
  provider          String?
  providerReference String?
  status            PaymentStatus   @default(PENDING)
  paidAt            DateTime?
  verifiedAt        DateTime?
  verifiedById      String?
  adminNote         String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User?           @relation("MemberPayments", fields: [userId], references: [id])
  membership        Membership?     @relation(fields: [membershipId], references: [id])
  accessRequest     AccessRequest?  @relation(fields: [accessRequestId], references: [id])
  plan              MembershipPlan? @relation(fields: [planId], references: [id])
  verifiedBy        User?           @relation("PaymentVerifier", fields: [verifiedById], references: [id])

  @@unique([provider, providerReference])
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([accessRequestId])
}

model AccountActivationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt, usedAt])
}

model RenewalRequest {
  id              String          @id @default(cuid())
  userId          String
  requestedPlanId String?
  status          RenewalStatus   @default(REQUESTED)
  memberNote      String?
  adminNote       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id])
  requestedPlan   MembershipPlan? @relation(fields: [requestedPlanId], references: [id])

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
}

model ContentItem {
  id                          String                  @id @default(cuid())
  type                        ContentType
  slug                        String
  stableKey                   String?                 @unique
  ownerId                     String?
  publishedRevisionId         String?                 @unique
  isArchived                  Boolean                 @default(false)
  accessMode                  ContentAccessMode       @default(ANY_SCOPE)
  previewJson                 String?
  primaryJourneyContentItemId String?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  owner                       User?                   @relation("ContentOwner", fields: [ownerId], references: [id])
  revisions                   ContentRevision[]       @relation("ContentRevisions")
  publishedRevision           ContentRevision?        @relation("PublishedRevision", fields: [publishedRevisionId], references: [id])
  bookmarks                   Bookmark[]
  activities                  ReadingActivity[]
  translations                ContentTranslation[]
  knowledgeScopes             ContentKnowledgeScope[]
  userContentGrants           UserContentGrant[]
  primaryJourney              ContentItem?            @relation("BaDocumentPrimaryJourney", fields: [primaryJourneyContentItemId], references: [id], onDelete: Restrict)
  baDocuments                 ContentItem[]           @relation("BaDocumentPrimaryJourney")

  @@unique([type, slug])
  @@index([type, isArchived])
  @@index([ownerId])
  @@index([accessMode])
  @@index([primaryJourneyContentItemId, type, isArchived])
}

model ContentTranslation {
  id                  String                @id @default(cuid())
  contentItemId       String
  locale              String
  slug                String
  title               String
  summary             String
  status              TranslationStatus     @default(NOT_STARTED)
  ownerId             String?
  publishedRevisionId String?               @unique
  sourceUpdatedAt     DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  contentItem         ContentItem           @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  owner               User?                 @relation("TranslationOwner", fields: [ownerId], references: [id])
  revisions           TranslationRevision[] @relation("TranslationRevisions")
  publishedRevision   TranslationRevision?  @relation("PublishedTranslationRevision", fields: [publishedRevisionId], references: [id])

  @@unique([contentItemId, locale])
  @@unique([locale, slug])
  @@index([locale, status])
  @@index([ownerId, status])
}

model TranslationRevision {
  id                   String              @id @default(cuid())
  contentTranslationId String
  version              Int
  status               RevisionStatus      @default(DRAFT)
  contentJson          String
  schemaVersion        Int                 @default(1)
  authorId             String?
  reviewerId           String?
  reviewNote           String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  submittedAt          DateTime?
  reviewedAt           DateTime?
  publishedAt          DateTime?
  contentTranslation   ContentTranslation  @relation("TranslationRevisions", fields: [contentTranslationId], references: [id], onDelete: Cascade)
  publishedFor         ContentTranslation? @relation("PublishedTranslationRevision")
  author               User?               @relation("TranslationAuthor", fields: [authorId], references: [id])
  reviewer             User?               @relation("TranslationReviewer", fields: [reviewerId], references: [id])

  @@unique([contentTranslationId, version])
  @@index([status, submittedAt])
  @@index([authorId, status])
}

model ContentRevision {
  id            String         @id @default(cuid())
  contentItemId String
  version       Int
  status        RevisionStatus @default(DRAFT)
  contentJson   String
  schemaVersion Int            @default(1)
  authorId      String?
  reviewerId    String?
  reviewNote    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  submittedAt   DateTime?
  reviewedAt    DateTime?
  publishedAt   DateTime?
  contentItem   ContentItem    @relation("ContentRevisions", fields: [contentItemId], references: [id], onDelete: Cascade)
  publishedFor  ContentItem?   @relation("PublishedRevision")
  author        User?          @relation("RevisionAuthor", fields: [authorId], references: [id])
  reviewer      User?          @relation("RevisionReviewer", fields: [reviewerId], references: [id])

  @@unique([contentItemId, version])
  @@index([status, submittedAt])
  @@index([authorId, status])
}

model Bookmark {
  id            String      @id @default(cuid())
  userId        String
  contentItemId String
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@unique([userId, contentItemId])
  @@index([userId, createdAt])
}

model ReadingActivity {
  id            String      @id @default(cuid())
  userId        String
  contentItemId String
  progress      Int         @default(0)
  completed     Boolean     @default(false)
  lastViewedAt  DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@unique([userId, contentItemId])
  @@index([userId, lastViewedAt])
}

model UserCareerPreference {
  id               String   @id @default(cuid())
  userId           String   @unique
  currentLevelSlug String
  targetLevelSlug  String
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  action       String
  entityType   String
  entityId     String
  metadataJson String?
  createdAt    DateTime @default(now())
  actor        User?    @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([action, entityType])
}

model KnowledgeScope {
  id                 String                       @id @default(cuid())
  code               String                       @unique
  type               KnowledgeScopeType
  nameEn             String
  nameVi             String
  descriptionEn      String
  descriptionVi      String
  parentId           String?
  displayOrder       Int                          @default(0)
  isActive           Boolean                      @default(true)
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  parent             KnowledgeScope?              @relation("ScopeHierarchy", fields: [parentId], references: [id])
  children           KnowledgeScope[]             @relation("ScopeHierarchy")
  contentMappings    ContentKnowledgeScope[]
  userGrants         UserScopeGrant[]
  packagePermissions KnowledgePackagePermission[]

  @@index([isActive, displayOrder])
  @@index([parentId])
}

model ContentKnowledgeScope {
  id               String                   @id @default(cuid())
  contentItemId    String
  knowledgeScopeId String
  relationshipType ContentScopeRelationship @default(PRIMARY)
  isRequired       Boolean                  @default(false)
  createdAt        DateTime                 @default(now())
  contentItem      ContentItem              @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  knowledgeScope   KnowledgeScope           @relation(fields: [knowledgeScopeId], references: [id])

  @@unique([contentItemId, knowledgeScopeId])
  @@index([contentItemId])
  @@index([knowledgeScopeId])
}

model UserScopeGrant {
  id               String              @id @default(cuid())
  userId           String
  knowledgeScopeId String
  permission       KnowledgePermission
  effect           GrantEffect         @default(ALLOW)
  status           GrantStatus         @default(ACTIVE)
  startsAt         DateTime?
  expiresAt        DateTime?
  grantedById      String
  reason           String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  revokedAt        DateTime?
  revokedById      String?
  user             User                @relation("ScopeGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  knowledgeScope   KnowledgeScope      @relation(fields: [knowledgeScopeId], references: [id])
  grantedBy        User                @relation("ScopeGrantCreator", fields: [grantedById], references: [id])
  revokedBy        User?               @relation("ScopeGrantRevoker", fields: [revokedById], references: [id])

  @@index([userId, status, startsAt, expiresAt])
  @@index([knowledgeScopeId, status])
  @@index([userId, knowledgeScopeId, permission, effect, status])
  @@index([expiresAt])
}

model UserContentGrant {
  id            String              @id @default(cuid())
  userId        String
  contentItemId String
  permission    KnowledgePermission
  effect        GrantEffect         @default(ALLOW)
  status        GrantStatus         @default(ACTIVE)
  startsAt      DateTime?
  expiresAt     DateTime?
  grantedById   String
  reason        String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  revokedAt     DateTime?
  revokedById   String?
  user          User                @relation("ContentGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  contentItem   ContentItem         @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  grantedBy     User                @relation("ContentGrantCreator", fields: [grantedById], references: [id])
  revokedBy     User?               @relation("ContentGrantRevoker", fields: [revokedById], references: [id])

  @@index([userId, status, startsAt, expiresAt])
  @@index([contentItemId, status])
  @@index([userId, contentItemId, permission, effect, status])
}

model KnowledgePackage {
  id            String                           @id @default(cuid())
  code          String                           @unique
  nameEn        String
  nameVi        String
  descriptionEn String
  descriptionVi String
  isActive      Boolean                          @default(true)
  displayOrder  Int                              @default(0)
  createdAt     DateTime                         @default(now())
  updatedAt     DateTime                         @updatedAt
  permissions   KnowledgePackagePermission[]
  assignments   UserKnowledgePackageAssignment[]

  @@index([isActive, displayOrder])
}

model KnowledgePackagePermission {
  id               String              @id @default(cuid())
  packageId        String
  knowledgeScopeId String
  permission       KnowledgePermission
  createdAt        DateTime            @default(now())
  package          KnowledgePackage    @relation(fields: [packageId], references: [id], onDelete: Cascade)
  knowledgeScope   KnowledgeScope      @relation(fields: [knowledgeScopeId], references: [id])

  @@unique([packageId, knowledgeScopeId, permission])
  @@index([knowledgeScopeId])
}

model UserKnowledgePackageAssignment {
  id           String                  @id @default(cuid())
  userId       String
  packageId    String
  status       PackageAssignmentStatus @default(ACTIVE)
  startsAt     DateTime?
  expiresAt    DateTime?
  assignedById String
  reason       String
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  revokedAt    DateTime?
  revokedById  String?
  user         User                    @relation("PackageAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  package      KnowledgePackage        @relation(fields: [packageId], references: [id])
  assignedBy   User                    @relation("PackageAssignmentCreator", fields: [assignedById], references: [id])
  revokedBy    User?                   @relation("PackageAssignmentRevoker", fields: [revokedById], references: [id])

  @@index([userId, status, startsAt, expiresAt])
  @@index([packageId, status])
  @@index([userId, packageId, status])
}

enum BaPlanStatus {
  DRAFT
  PENDING_APPROVAL
  CHANGES_REQUESTED
  APPROVED
  CLOSED
}

enum BaQuarterStatus {
  KPI_DRAFT
  KPI_PENDING
  IN_PROGRESS
  RESULTS_SUBMITTED
  REVIEWED
}

/// GTE ≥, LTE ≤, EQ =; DONE is a milestone reported as done (1) or not (0).
enum KpiComparator {
  GTE
  LTE
  EQ
  DONE
}

/// Internal BA team annual capability and KPI plan. One plan per member per calendar year.
model BaPerformancePlan {
  id                   String          @id @default(cuid())
  userId               String
  year                 Int
  status               BaPlanStatus    @default(DRAFT)
  profileJson          String
  approvedSnapshotJson String?
  managerNotesJson     String?
  reviewNote           String?
  submittedAt          DateTime?
  approvedAt           DateTime?
  approvedById         String?
  annualOutcomesJson   String?
  annualRating         Int?
  annualAssessment     String?
  annualReviewedAt     DateTime?
  annualReviewedById   String?
  closedAt             DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  user                 User            @relation("BaPlanOwner", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy           User?           @relation("BaPlanApprover", fields: [approvedById], references: [id])
  annualReviewedBy     User?           @relation("BaPlanAnnualReviewer", fields: [annualReviewedById], references: [id])
  quarters             BaPlanQuarter[]

  @@unique([userId, year])
  @@index([year, status])
}

/// One quarterly KPI cycle of a plan: KPI set approval, in-quarter progress, results and Lead review.
model BaPlanQuarter {
  id                 String               @id @default(cuid())
  planId             String
  quarter            Int
  status             BaQuarterStatus      @default(KPI_DRAFT)
  changeNote         String?
  returnNote         String?
  kpiSubmittedAt     DateTime?
  kpiApprovedAt      DateTime?
  kpiApprovedById    String?
  resultsSubmittedAt DateTime?
  reviewRating       Int?
  reviewAssessment   String?
  reviewedAt         DateTime?
  reviewedById       String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  plan               BaPerformancePlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  kpiApprovedBy      User?                @relation("BaQuarterKpiApprover", fields: [kpiApprovedById], references: [id])
  reviewedBy         User?                @relation("BaQuarterReviewer", fields: [reviewedById], references: [id])
  kpis               BaQuarterKpi[]
  objectives         BaQuarterObjective[]
  adjustments        BaKpiAdjustment[]

  @@unique([planId, quarter])
  @@index([status])
}

/// A KPI within one quarter. lineageKey identifies the same KPI across quarters of a plan.
model BaQuarterKpi {
  id             String              @id @default(cuid())
  quarterId      String
  lineageKey     String
  templateId     String?
  objectiveId    String?
  capabilityArea String?
  name           String
  description    String?
  comparator     KpiComparator
  targetValue    Float
  unitLabel      String
  sortOrder      Int                 @default(0)
  actualValue    Float?
  memberNote     String?
  evidenceUrl    String?
  leadComment    String?
  removedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  quarter        BaPlanQuarter       @relation(fields: [quarterId], references: [id], onDelete: Cascade)
  template       BaKpiTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  objective      BaQuarterObjective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  progressLogs   BaKpiProgressLog[]

  @@unique([quarterId, lineageKey])
  @@index([objectiveId])
}

/// OKR Objective for one quarter; its KPIs are the Key Results. SMART: Measurable comes from the
/// linked KPIs and Time-bound from the quarter end, so only S, A and R are stored.
model BaQuarterObjective {
  id            String         @id @default(cuid())
  quarterId     String
  lineageKey    String
  title         String
  specific      String         @default("")
  achievable    String         @default("")
  relevant      String         @default("")
  /// Key of the annual goal (BaPerformancePlan.profileJson annualGoals) this Objective serves.
  annualGoalKey String?
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  quarter       BaPlanQuarter  @relation(fields: [quarterId], references: [id], onDelete: Cascade)
  kpis          BaQuarterKpi[]

  @@unique([quarterId, lineageKey])
}

/// Append-only log of every actual-value update.
model BaKpiProgressLog {
  id            String       @id @default(cuid())
  kpiId         String
  previousValue Float?
  newValue      Float
  note          String?
  evidenceUrl   String?
  authorId      String
  createdAt     DateTime     @default(now())
  kpi           BaQuarterKpi @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  author        User         @relation("BaKpiProgressAuthor", fields: [authorId], references: [id])

  @@index([kpiId, createdAt])
}

/// Append-only history of Lead mid-quarter KPI adjustments, visible to the plan owner.
model BaKpiAdjustment {
  id         String        @id @default(cuid())
  quarterId  String
  lineageKey String
  action     String
  beforeJson String?
  afterJson  String?
  reason     String
  actorId    String
  createdAt  DateTime      @default(now())
  quarter    BaPlanQuarter @relation(fields: [quarterId], references: [id], onDelete: Cascade)
  actor      User          @relation("BaKpiAdjustmentActor", fields: [actorId], references: [id])

  @@index([quarterId, createdAt])
}

/// Lead-managed KPI template library.
model BaKpiTemplate {
  id             String         @id @default(cuid())
  capabilityArea String
  name           String         @unique
  description    String?
  comparator     KpiComparator
  defaultTarget  Float
  unitLabel      String
  sortOrder      Int            @default(0)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  kpis           BaQuarterKpi[]
}

enum BaLevel {
  FRESHER
  JUNIOR
  MIDDLE
  SENIOR
  PRINCIPAL
}

enum BaBillableStatus {
  BILLABLE
  PARTIAL_BILLABLE
  NON_BILLABLE
}

enum BaPerformanceRating {
  OUTSTANDING
  EXCELLENT
  GOOD
  NEEDS_IMPROVEMENT
  UNDERPERFORMING
}

enum BaRiskLevel {
  LOW
  MEDIUM
  HIGH
}

/// BA resource profile: the single source of Level and Capacity for allocation and KPI plans.
model BaTeamProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  level           BaLevel?
  capacityPercent Int      @default(100)
  hoursPerWeek    Int      @default(40)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Customer catalogue for resource allocation. Internal marks the own organisation.
model BaCustomer {
  id         String      @id @default(cuid())
  name       String      @unique
  isInternal Boolean     @default(false)
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  projects   BaProject[]
}

model BaProject {
  id                    String           @id @default(cuid())
  customerId            String
  name                  String
  defaultBillableStatus BaBillableStatus @default(BILLABLE)
  isActive              Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  customer              BaCustomer       @relation(fields: [customerId], references: [id])
  allocations           BaAllocation[]

  @@unique([customerId, name])
}

model BaProjectRole {
  id          String         @id @default(cuid())
  name        String         @unique
  sortOrder   Int            @default(0)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  allocations BaAllocation[]
}

/// One assignment of a BA to a project. Status, availability and forecast are derived on read, never stored.
model BaAllocation {
  id             String               @id @default(cuid())
  userId         String
  projectId      String
  roleId         String
  percent        Int
  billableStatus BaBillableStatus
  startDate      DateTime             @db.Date
  endDate        DateTime?            @db.Date
  cancelledAt    DateTime?
  deletedAt      DateTime?
  performance    BaPerformanceRating?
  risk           BaRiskLevel?
  managerRemark  String?
  createdById    String
  updatedById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  user           User                 @relation("BaAllocationOwner", fields: [userId], references: [id], onDelete: Cascade)
  project        BaProject            @relation(fields: [projectId], references: [id])
  role           BaProjectRole        @relation(fields: [roleId], references: [id])
  createdBy      User                 @relation("BaAllocationCreator", fields: [createdById], references: [id])
  updatedBy      User?                @relation("BaAllocationUpdater", fields: [updatedById], references: [id])

  @@index([userId, deletedAt])
  @@index([projectId])
}
