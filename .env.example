# Local SQLite database. Use a managed database and a private connection string in production.
DATABASE_URL="file:./dev.db"

# Generate a unique value of at least 32 characters. Never commit the generated value.
AUTH_SECRET=""

# Optional development seed accounts. Leave blank to avoid creating them.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Platform Administrator"
SEED_MEMBER_EMAIL=""
SEED_MEMBER_PASSWORD=""
SEED_MEMBER_NAME="Development Member"

# Public application origin used to construct activation links.
APP_BASE_URL="http://localhost:3000"

# One-time activation-link lifetime.
ACTIVATION_TOKEN_TTL_HOURS="48"
