# Database used by the current environment.
# Local development must use a Neon development branch.
DATABASE_URL=""

# Direct non-pooled Neon connection used by Prisma migrations.
DIRECT_URL=""

# Explicit application and database safety labels.
APP_ENV="development"
DATABASE_ENVIRONMENT="development"

# Public application origin.
APP_BASE_URL="http://localhost:3000"

# Generate a unique local value of at least 32 characters.
AUTH_SECRET=""

# Production database operations require a separately reviewed procedure.
ALLOW_PRODUCTION_DATABASE_OPERATIONS="false"

# Static premium-content fallback must remain disabled in production.
ENABLE_STATIC_CONTENT_FALLBACK="false"

# One-time activation-link lifetime in hours.
ACTIVATION_TOKEN_TTL_HOURS="48"
